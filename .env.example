# ===== AQDAS MD settings (copy this file to .env and fill) =====
# Bot ka naam / brand
BOT_NAME=AQDAS MD
OWNER_NAME=AQDAS HACKER
# Owner ka WhatsApp number (country code ke sath, + ya 0 ke baghair) e.g. 923001234567
OWNER_NUMBER=
# Command prefix (default .)
PREFIX=.
# public = sab commands use kar saktay hain, private = sirf owner
MODE=public

# Pairing: jis number pe bot chalana hai (spare number), country code ke sath, e.g. 923001234567
# Termux pe khali chhor do to start pe poochega. Server pe web page se bhi daal saktay ho.
PAIR_NUMBER=

# Web pairing page (server ke liye). Server khud PORT deta hai.
WEB=true
PORT=3000
# Web page ka password (zaroor badlo!)
ADMIN_PASSWORD=change-me-123

# Free host pe session bachanay ke liye (bot connect honay ke baad .session command ya web page se milta hai)
SESSION_ID=

# AI chat (.ai) - apni OpenRouter key yahan daalo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Auto features default (owner baad mein commands se ON/OFF kar sakta hai)
AUTO_REACT=true
AUTO_REACT_EMOJIS=❤️,🔥,😂,😍,👍,💯,😎,🥰,🤖,⚡
AUTO_REACT_SCOPE=all
AUTO_READ=false
AUTO_STATUS_VIEW=true
AUTO_STATUS_REACT=false
STATUS_REACT_EMOJIS=💚,🔥,😍,💯
ALWAYS_ONLINE=false
AUTO_TYPING=false
# pehli dafa connect honay pe bot ka DP (media/dp.jpg) laga do
SET_DP_ON_FIRST_CONNECT=true
# .menu ke sath song bhejo
MENU_SONG=true
# Time zone
TZ=Asia/Karachi
