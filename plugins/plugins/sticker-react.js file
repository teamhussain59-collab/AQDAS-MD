// ═══════════════════════════════════════════════════════════════════
//  AQDAS MD — Auto Sticker React (No Reply/Quote)
//  Commands: .streact / .streact off / .streact reset
// ═══════════════════════════════════════════════════════════════════

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { downloadMediaMessage } from '@whiskeysockets/baileys';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const DATA_DIR = path.join(__dirname, '..', 'data');
const STICKER_DIR = path.join(DATA_DIR, 'stickers');
const STATE_FILE = path.join(DATA_DIR, 'streaction.json');

// Folders create karein agar nahi hain toh
if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
if (!fs.existsSync(STICKER_DIR)) fs.mkdirSync(STICKER_DIR, { recursive: true });

let state = loadState();
const hookedSocks = new WeakSet();

function loadState() {
  try { return JSON.parse(fs.readFileSync(STATE_FILE, 'utf8')); }
  catch { return { enabled: false, step: 'idle', stickers: [] }; }
}

function saveState() {
  try { fs.writeFileSync(STATE_FILE, JSON.stringify(state, null, 2)); }
  catch (e) { console.error('[StickerReact] save error:', e.message); }
}

// Bot ke khud ke message ID check karne ke liye (taake infinite loop na bane)
function isBotMsgId(id) {
  return /^(3EB0|BAE5)/.test(String(id || ''));
}

function ensureHook(ctx) {
  const sock = ctx.sock;
  if (!sock || hookedSocks.has(sock)) return;
  hookedSocks.add(sock);

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    if (type !== 'notify') return;

    for (const msg of messages) {
      try {
        if (!msg?.message || !msg.key?.remoteJid) continue;
        const jid = msg.key.remoteJid;
        
        // Bot ki khud ki messages ignore karega
        if (isBotMsgId(msg.key.id)) continue; 

        // 1. Stickers save karne ka process (Setup)
        if (state.step === 'await_stickers') {
           if (msg.message.stickerMessage) {
               // Sticker download karein
               const buffer = await downloadMediaMessage(msg, 'buffer', {}, { 
                   reuploadRequest: sock.updateMediaMessage 
               });
               
               const fileName = `sticker_${Date.now()}.webp`;
               const filePath = path.join(STICKER_DIR, fileName);
               fs.writeFileSync(filePath, buffer);
               
               state.stickers.push(filePath);
               saveState();
               
               const remaining = 5 - state.stickers.length;
               if (remaining > 0) {
                   await sock.sendMessage(jid, { text: `✅ Sticker ${state.stickers.length}/5 saved.\nBhejein aur *${remaining}* stickers.` });
               } else {
                   state.step = 'idle';
                   state.enabled = true;
                   saveState();
                   await sock.sendMessage(jid, { text: `🔥 *All 5 stickers saved!*\n\nAb aap jab bhi message karenge, bot foran niche 1 random sticker bhejega.` });
               }
               continue;
           } else if (msg.key.fromMe) {
               continue;
           }
        }

        // 2. Auto Sticker (Jab aap message karein)
        if (state.enabled && msg.key.fromMe && !msg.message.stickerMessage) {
            const text = msg.message.conversation || msg.message.extendedTextMessage?.text || '';
            
            // Commands ko ignore karega taake har command par sticker na aaye
            if (text && /^[./!#]/.test(text)) continue;

            if (state.stickers.length > 0) {
                const randomSticker = state.stickers[Math.floor(Math.random() * state.stickers.length)];
                if (fs.existsSync(randomSticker)) {
                    const buffer = fs.readFileSync(randomSticker);
                    
                    // Yahan { quoted: msg } NAHI hai. Isliye reply box nahi banega, 
                    // sticker seedha message ke niche aayega (Jaise screenshot mein hai).
                    await sock.sendMessage(jid, { sticker: buffer }); 
                }
            }
        }

      } catch (e) { console.error('[StickerReact] error:', e.message); }
    }
  });
}

export default {
  name: 'streact',
  alias: ['stickerreact', 'sreact'],
  category: 'tools',

  async run(ctx) {
    ensureHook(ctx);
    const arg = (ctx.text || '').trim().toLowerCase();

    // OFF COMMAND
    if (arg === 'off') {
        state.enabled = false;
        state.step = 'idle';
        saveState();
        return ctx.reply('❌ *Sticker Auto-React OFF!*');
    }

    // RESET COMMAND
    if (arg === 'reset') {
        state.stickers = [];
        state.enabled = false;
        state.step = 'idle';
        saveState();
        if (fs.existsSync(STICKER_DIR)) {
            const files = fs.readdirSync(STICKER_DIR);
            for (const file of files) fs.unlinkSync(path.join(STICKER_DIR, file));
        }
        return ctx.reply('🗑️ *Sticker React Reset!* Purane stickers delete ho gaye.');
    }

    // SETUP START
    state.stickers = []; 
    state.enabled = false;
    state.step = 'await_stickers';
    saveState();

    return ctx.reply(`🔥 *Sticker Auto-React Setup*\n\nAb aap ek ke baad ek *5 stickers* bhejein. Bot unko save kar lega.\n\n❌ Cancel: *.streact off*`);
  }
};
